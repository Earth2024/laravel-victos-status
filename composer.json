{
    "name": "earth2024/laravel-victos-status",
    "description": "Tenant-scoped refund status cards and a framework-agnostic browser widget for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0",
        "illuminate/auth": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/validation": "^12.0",
        "illuminate/view": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Earth2024\\VictosStatus\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Earth2024\\VictosStatus\\VictosStatusServiceProvider"
            ]
        }
    }
}
